# ==============================================================================
# TaskCatch Environment Configuration Example
# Copy to .env and configure. NEVER commit .env or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Server Configuration (/apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# SQLite Database path (WAL mode enabled automatically)
DATABASE_PATH=./data/taskcatch.sqlite

# JWT Secret for local user session tokens
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_bytes

# Default User ID (single-user personal system default)
DEFAULT_USER_ID=user_personal_01

# Storage directory for recorded and normalized audio
STORAGE_DIR=./data/uploads

# ------------------------------------------------------------------------------
# 2. Speech-to-Text Sidecar (/apps/stt)
# ------------------------------------------------------------------------------
STT_PROVIDER=faster-whisper
STT_SERVICE_URL=http://127.0.0.1:8000
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Optional: Groq Whisper Cloud (permanently disabled by default)
ENABLE_GROQ_WHISPER=false
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 3. LLM Translation & Task Extraction (/apps/api)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional: Google Gemini Free Tier (disabled by default)
ENABLE_GEMINI_FALLBACK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# System Timezone for Relative Date Calculations (e.g. 'kal', 'parso')
TIMEZONE=Asia/Calcutta

# ------------------------------------------------------------------------------
# 4. Firebase Cloud Messaging (FCM) - Free Spark Plan
# ------------------------------------------------------------------------------
# Option A: Absolute path to service account JSON (recommended for local machine)
FIREBASE_SERVICE_ACCOUNT_PATH=/home/lenovo/intellisolar-crm/platform-new/intellisolar-crm-notification-firebase-adminsdk-fbsvc-3dd6575ad9.json

# Option B: Raw JSON string in environment (alternative)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Option C: Direct env parameters
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 5. Web App & PWA Public Configuration (/apps/web)
# Note: Vite client env vars MUST start with VITE_
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws

# Firebase Client Web Config (Public client configuration)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_VAPID_KEY=your_fcm_web_push_vapid_key

# ------------------------------------------------------------------------------
# 6. Tailscale Remote HTTPS (Optional for mobile microphone capture)
# ------------------------------------------------------------------------------
TAILSCALE_HOSTNAME=your-machine.tailnet-xyz.ts.net
